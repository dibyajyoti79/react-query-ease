{
  "name": "react-query-ease",
  "version": "0.3.0",
  "description": "Typed Axios + TanStack React Query API clients in a few lines — useQuery/useMutation hooks, auto cache invalidation, single-flight token refresh, and streaming (SSE/LLM) hooks for React and Next.js.",
  "keywords": [
    "react",
    "react-query",
    "tanstack-query",
    "tanstack",
    "axios",
    "api-client",
    "http-client",
    "data-fetching",
    "fetch",
    "hooks",
    "react-hooks",
    "usequery",
    "usemutation",
    "typescript",
    "nextjs",
    "rest",
    "interceptor",
    "auth",
    "refresh-token",
    "jwt",
    "streaming",
    "sse",
    "server-sent-events",
    "llm",
    "ai",
    "cache-invalidation"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "default": "./dist/index.esm.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dibyajyoti79/react-query-ease.git"
  },
  "homepage": "https://github.com/dibyajyoti79/react-query-ease#readme",
  "bugs": {
    "url": "https://github.com/dibyajyoti79/react-query-ease/issues"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "test": "echo \"No tests defined\"",
    "lint": "eslint . --ext .ts,.tsx",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=4.0.0",
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.59.16",
    "@types/react": "^19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.13.2"
  },
  "license": "MIT"
}

{
  "name": "react-query-ease",
  "version": "0.5.1",
  "description": "Typed Axios + TanStack React Query API clients in a few lines — useQuery/useMutation hooks, auto cache invalidation, single-flight token refresh, and streaming (SSE/LLM) hooks for React and Next.js.",
  "keywords": [
    "react",
    "react-query",
    "tanstack-query",
    "tanstack",
    "axios",
    "api-client",
    "http-client",
    "data-fetching",
    "fetch",
    "hooks",
    "react-hooks",
    "usequery",
    "usemutation",
    "typescript",
    "nextjs",
    "rest",
    "interceptor",
    "auth",
    "refresh-token",
    "jwt",
    "streaming",
    "sse",
    "server-sent-events",
    "llm",
    "ai",
    "cache-invalidation"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dibyajyoti79/react-query-ease.git"
  },
  "homepage": "https://github.com/dibyajyoti79/react-query-ease#readme",
  "bugs": {
    "url": "https://github.com/dibyajyoti79/react-query-ease/issues"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "test": "vitest run",
    "lint": "oxlint",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p type-tests"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^4.0.0 || ^5.0.0",
    "axios": "^1.8.2",
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.59.16",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.3.0",
    "axios": "^1.13.2",
    "jsdom": "^31.0.1",
    "oxlint": "^1.95.0",
    "prettier": "^3.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  },
  "license": "MIT"
}
